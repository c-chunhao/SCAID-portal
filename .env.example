# Examples only. Generate your own secret and keep populated values outside Git.
SCAID_DEPLOYMENT=local
SCAID_SECRET_KEY=<GENERATE_NEW_SECRET_OF_AT_LEAST_50_CHARACTERS>
SCAID_DEBUG=false
SCAID_ALLOWED_HOSTS=127.0.0.1,localhost
SCAID_DB_ENGINE=sqlite
SCAID_SQLITE_PATH=/tmp/scaid-demo.sqlite3
SCAID_FIGURE_ROOT=/tmp/scaid-synthetic-demo/figures
SCAID_H5_DOWNLOAD_ROOTS=/tmp/scaid-synthetic-demo/h5
SCAID_MEDIA_ROOT=/tmp/scaid-synthetic-demo/media
SCAID_THUMBNAIL_ROOT=/tmp/scaid-synthetic-demo/thumbs
# mysql production: configure new DB values privately and use a SELECT-only web user.
# SCAID_DB_NAME=<your_database>
# SCAID_DB_USER=<your_read_only_web_user>
# SCAID_DB_PASSWORD=<your_private_password>
# SCAID_DB_HOST=127.0.0.1
# SCAID_DB_PORT=3306
# SCAID_DEPLOYMENT=production
# SCAID_ALLOWED_HOSTS=<your_domain>
# SCAID_TRUST_PROXY_SSL=true

# Optional prepared gene/score image family tree; no private source paths.
SCAID_PUBLISHED_FIGURES_BASE=/srv/scaid/data/source_gene_score

# Optional new-module resources prepared and validated locally; examples only.
SCAID_MARKERS_ROOT=/srv/scaid/local/marker_assets
SCAID_GENE_CACHE_MANIFEST=/srv/scaid/local/gene_cache/lazy_gene_plots.json
